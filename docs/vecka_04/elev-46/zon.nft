#!/usr/sbin/nft -f
flush ruleset

table inet zon {
  chain in {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif "lo" accept
    ip saddr 172.20.1.2 tcp dport 22 accept comment "D1 SSH från jump"
    ip saddr 172.20.1.10 tcp dport 22 accept comment "D2 kontroll från ctf"
    ip saddr 172.20.1.2 icmp type echo-request accept comment "F22 ping från jump"
    iifname "eth0" tcp dport 80 accept comment "F4 internet till webb"
    limit rate 10/minute log prefix "ZON-IN-DROP " level info
  }
  chain ut {
    type filter hook output priority 0; policy drop;
    ct state established,related accept
    oif "lo" accept
    ip daddr { 185.12.64.1, 185.12.64.2 } meta l4proto { tcp, udp } th dport 53 accept comment "D3 DNS"
    ip daddr { 213.239.239.164, 213.239.239.165, 213.239.239.166 } udp dport 123 accept comment "D4 tidssynk till Hetzner"
    udp sport 68 udp dport 67 accept comment "D6 DHCP-förnyelse"
    oifname "eth0" tcp dport 443 accept comment "D7 paketuppdateringar dnf"
    ip daddr 10.40.1.96/27 tcp dport 8080 accept comment "F9 webben hämtar data från appservern"
    limit rate 10/minute log prefix "ZON-UT-DROP " level info
  }
}
