#!/usr/sbin/nft -f
# elev-09 – Klientzon, teamnätet 10.40.1.2 på eth2.
# Byggt ur flödestabellen (docs/vecka_03/flodestabell.md) och driftflödena
# (docs/vecka_04/zonuppdelning/flodestabell-driftfloden.md). Varje regel har radens id som kommentar.
# Läggs i /etc/nftables/zon.nft och inkluderas från /etc/sysconfig/nftables.conf.
flush ruleset

define JUMP        = 172.20.1.2
define CTF         = 172.20.1.10
define LOG         = 172.20.1.58
define HETZNER_DNS = { 185.12.64.1, 185.12.64.2 }
define SERVERZON   = 10.40.1.96/27

table inet zon {
    chain in {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        ct state invalid drop
        iif "lo" accept
        ip saddr $JUMP tcp dport 22 accept comment "D1/16 SSH från jump"
        ip saddr $CTF tcp dport 22 accept comment "D2 kontroll från ctf"
        ip saddr $JUMP icmp type echo-request accept comment "22 ping från adminzon"
        ip saddr $CTF tcp dport 80 accept comment "L1 ctf testar webbservern"
        limit rate 10/minute log prefix "ZON-IN-DROP " level info
    }

    chain ut {
        type filter hook output priority 0; policy drop;
        ct state established,related accept
        oif "lo" accept
        ip daddr $HETZNER_DNS meta l4proto { tcp, udp } th dport 53 accept comment "D3/7 DNS"
        oifname "eth0" udp dport 123 accept comment "D4/19 NTP"
        ip daddr $LOG tcp dport 514 accept comment "D5 brandväggslogg till log"
        udp sport 68 udp dport 67 accept comment "D6/23 DHCP-förnyelse"
        ip daddr $SERVERZON tcp dport 443 accept comment "8 klienter till intern webbapp"
        oifname "eth0" tcp dport { 80, 443 } accept comment "6/D7 webb och paketuppdateringar"
        limit rate 10/minute log prefix "ZON-UT-DROP " level info
    }
}
